<mujoco model="m2 gravel plain steps scene">
  <include file="m2_metal.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <!-- Sky -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>

    <!-- Plain ground (checker) -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Gravel patch -->
    <texture type="2d" name="graveltex" builtin="flat" mark="random" rgb1="0.45 0.42 0.38" rgb2="0.55 0.52 0.47"
      markrgb="0.35 0.32 0.28" random="0.6" width="300" height="300"/>
    <material name="gravel" texture="graveltex" texuniform="true" texrepeat="10 10" reflectance="0.0"
      specular="0.05" shininess="0.05"/>

    <!-- Wood for steps -->
    <texture type="2d" name="woodtex" builtin="flat" mark="edge" rgb1="0.7 0.5 0.3" rgb2="0.6 0.4 0.2"
      width="300" height="300"/>
    <material name="wood" texture="woodtex" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Base plain floor (fallback under everything) -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Explicit flat plain area near the origin -->
    <geom name="plain_area" type="box" size="1.8 3 0.02" pos="-1.8 2 0.02" material="groundplane"/>

    <!-- Gravel patch area -->
    <geom name="gravel_area" type="box" size="1.8 3 0.02" pos="-1.8 -2 0.02" material="gravel"/>

    <!-- Step test 1: single low platform -->
    <geom name="step1" size="1 1 0.05" type="box" material="wood" pos="2 0 0.0"/>

    <!-- Step test 2: staircase up and back down -->
    <geom name="step2_1" type="box" size="0.4 0.6 0.05" pos="6.2 0 0.05" material="wood"/>
    <geom name="step2_2" type="box" size="0.3 0.6 0.1"  pos="5.8 0 0.1"  material="wood"/>
    <geom name="step2_3" type="box" size="0.2 0.6 0.15" pos="5.5 0 0.15" material="wood"/>
    <geom name="step2_4" type="box" size="0.2 0.6 0.22" pos="5.1 0 0.22" material="wood"/>
    <geom name="step2_5" type="box" size="0.4 0.6 0.3"  pos="4.5 0 0.3"  material="wood"/>
    <geom name="step2_6" type="box" size="0.2 0.6 0.22" pos="3.9 0 0.22" material="wood"/>
    <geom name="step2_7" type="box" size="0.2 0.6 0.15" pos="3.5 0 0.15" material="wood"/>
    <geom name="step2_8" type="box" size="0.3 0.6 0.1"  pos="3.2 0 0.1"  material="wood"/>
    <geom name="step2_9" type="box" size="0.4 0.6 0.05" pos="2.8 0 0.05" material="wood"/>

    <!-- Step test 3: finer staircase ramp -->
    <geom name="step3_1"  type="box" size="0.1 2.4 0.02" pos="2   2 0.02" material="wood"/>
    <geom name="step3_2"  type="box" size="0.1 2.4 0.04" pos="2.1 2 0.04" material="wood"/>
    <geom name="step3_3"  type="box" size="0.1 2.4 0.06" pos="2.3 2 0.06" material="wood"/>
    <geom name="step3_4"  type="box" size="0.1 2.4 0.08" pos="2.4 2 0.08" material="wood"/>
    <geom name="step3_5"  type="box" size="0.1 2.4 0.1"  pos="2.5 2 0.1"  material="wood"/>
    <geom name="step3_6"  type="box" size="0.1 2.4 0.12" pos="2.6 2 0.12" material="wood"/>
    <geom name="step3_7"  type="box" size="0.1 2.4 0.14" pos="2.7 2 0.14" material="wood"/>
    <geom name="step3_8"  type="box" size="0.1 2.4 0.16" pos="2.9 2 0.16" material="wood"/>
    <geom name="step3_9"  type="box" size="0.1 2.4 0.18" pos="3   2 0.18" material="wood"/>
    <geom name="step3_10" type="box" size="0.1 2.4 0.19" pos="3.1 2 0.19" material="wood"/>
    <geom name="step3_11" type="box" size="0.1 2.4 0.2"  pos="3.2 2 0.2"  material="wood"/>
    <geom name="step3_12" type="box" size="0.1 2.4 0.21" pos="3.3 2 0.21" material="wood"/>
    <geom name="step3_13" type="box" size="0.1 2.4 0.22" pos="3.4 2 0.22" material="wood"/>
    <geom name="step3_14" type="box" size="0.1 2.4 0.24" pos="3.6 2 0.24" material="wood"/>
    <geom name="step3_15" type="box" size="0.1 2.4 0.25" pos="3.7 2 0.25" material="wood"/>
    <geom name="step3_16" type="box" size="0.1 2.4 0.22" pos="3.8 2 0.22" material="wood"/>
    <geom name="step3_17" type="box" size="0.1 2.4 0.19" pos="3.9 2 0.19" material="wood"/>
    <geom name="step3_18" type="box" size="0.1 2.4 0.16" pos="4   2 0.16" material="wood"/>
    <geom name="step3_19" type="box" size="0.1 2.4 0.13" pos="4.1 2 0.13" material="wood"/>
    <geom name="step3_20" type="box" size="0.1 2.4 0.10" pos="4.2 2 0.10" material="wood"/>
    <geom name="step3_21" type="box" size="0.1 2.4 0.07" pos="4.3 2 0.07" material="wood"/>
    <geom name="step3_22" type="box" size="0.1 2.4 0.04" pos="4.4 2 0.04" material="wood"/>
  </worldbody>
</mujoco>
