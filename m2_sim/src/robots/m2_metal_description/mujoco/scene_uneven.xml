<mujoco model="m2 metal scene">
    <include file="m2_metal.xml"/>
    
    <statistic center="0 0 0.5" extent="2"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="307"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        
        <hfield name="terrain_hf" file="terrain_coarse.png" size="5.0 5.0 1.0 0.1"/>
        
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" directional="true"/>
        
        <geom name="terrain" type="hfield" hfield="terrain_hf" rgba="0.8 0.8 0.8 1" pos="0 0 -0.5" material="matplane"/>

        </worldbody>
</mujoco>